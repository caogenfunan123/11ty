---
layout: layout.njk
title: 首页
---

{% include "header.njk" %}

<div class="index-main">
  <div class="index-header">
    <h1 class="index-logo">{{ site.title }}</h1>
    <div class="index-header-line">{{ site.description }}</div>
  </div>

  {% if site.showInMenu %}
  <div class="post-list">
    {% set posts = collections.post | reverse %}
    {% for post in posts %}
    <article class="post">
      <h2 class="post-title">
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
      <div class="post-except">{{ post.data.excerpt or post.data.description or post.content | stripHtml | truncate(150) }}</div>
      <div class="post-date">{{ post.data.date | date("YYYY-MM-DD") }}</div>
    </article>
    {% endfor %}
  </div>
  {% endif %}
</div>

{% include "footer.njk" %}
